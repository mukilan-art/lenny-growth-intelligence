# ==============================================================================
# LENNY GROWTH INTELLIGENCE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Metadata
PROJECT_NAME="Lenny Growth Intelligence"
ENVIRONMENT="development"

# Database Configuration
# Default: Local SQLite database with full table schema
# Production / PostgreSQL: postgresql://postgres:postgres@localhost:5432/lenny_growth
DATABASE_URL="sqlite:///./data/lenny_growth.db"

# Knowledge Ingestion Path
TRANSCRIPTS_PATH="./transcripts_repo"

# Default Model Provider: "ollama", "anthropic", or "openai"
DEFAULT_PROVIDER="ollama"

# 1. Ollama (Local AI Model Provider)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2"

# 2. Anthropic Claude (Cloud AI Provider)
# Set your Anthropic API Key below:
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# 3. OpenAI (Cloud AI Provider)
# Set your OpenAI API Key below:
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# Agent Integration Mode
AGENT_TYPE="claude_agent"
