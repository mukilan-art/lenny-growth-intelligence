# ==============================================================================
# LENNY GROWTH INTELLIGENCE - ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================

# Application Metadata
PROJECT_NAME="Lenny Growth Intelligence"
ENVIRONMENT="development"

# Database Configuration (PostgreSQL primary)
DATABASE_URL="postgresql+psycopg://postgres:your_password@localhost:5432/lenny_growth"

# Auth
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Knowledge Ingestion Path
TRANSCRIPTS_PATH="./transcripts_repo"

# Default Model Provider: "ollama", "anthropic", or "openai"
DEFAULT_PROVIDER="ollama"

# 1. Ollama (Local AI Model Provider)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2"

# 2. Anthropic Claude (Cloud AI Provider)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# 3. OpenAI (Cloud AI Provider)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# Agent Integration Mode
AGENT_TYPE="claude_agent"
